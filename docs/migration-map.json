{
  "version": 1,
  "_note": [
    "文档归位迁移表（卡 F1 · T-AG449）。口径见 tools/migrate_docs.py 文件头与 docs/文档架构.md §4。",
    "moves 按『期』分组：二期 = 卡规格；三期 = 复盘根层项目书/计划/设计（需先批准）。",
    "candidates 里 verdict=pending 的一律不动 —— 三期要人先分类（回头看 vs 往前做），脚本不替人下判断。",
    "skip 是『路径是拓扑数据/历史描述，机械改会把语义改没』的文件：脚本只报『需人工』，不改。",
    "code_probes 是代码里把目录写成路径分量的地方：路径串改不动它，必须人手改（脚本迁移后照样会点名）。"
  ],
  "moves": [
    {
      "id": "cards",
      "phase": "二期",
      "glob": "复盘/卡/*.md",
      "to_dir": "docs/cards",
      "why": "卡规格是在飞的工作定义，不是历史（docs/文档架构.md §4 二期）"
    }
  ],
  "rewrite": {
    "roots": [
      "docs",
      "skills",
      "tools",
      "scripts",
      "tests",
      "src",
      "复盘"
    ],
    "suffixes": [
      ".md",
      ".toml",
      ".py",
      ".json",
      ".txt",
      ".yml",
      ".yaml",
      ".mjs",
      ".js",
      ".ps1",
      ".sh"
    ],
    "skip": [
      "docs/migration-map.json",
      "docs/文档架构.md",
      "tests/test_wb_tree.py"
    ]
  },
  "code_probes": [
    {
      "path": "tools/pool/plan.py",
      "pattern": "ROOT / \"复盘\" / \"卡\"",
      "why": "find_spec 的搜索根：卡规格搬走后这里必须跟着指向 docs/cards（否则找卡全落空）"
    },
    {
      "path": "tests/test_wb_tree.py",
      "pattern": "\"复盘/卡/卡A302.md\"",
      "why": "提交区判定的拓扑钉子：路径改到 docs/cards 后这条断言要按『docs 区的卡』重写，不是替换字符串"
    }
  ],
