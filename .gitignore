# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# 虚拟环境
.venv/
venv/

# 本地配置（敏感，不入库）
config.toml

# Obsidian 本地库配置
.obsidian/

# 本地数据 + 备份（★ 整目录忽略：`data/` 里**一个被跟踪的文件都没有**）
# 为什么不再一条条列：窄规则总会漏下一种命名 —— 实测 `data/timeflow.db.before-acceptance`
# 既不匹配 `data/*.db-*`（那是 `.db-xxx`）也不匹配别的 ⇒ `git status` 一直挂着 `?? data/`。
data/
backups/
*.sqlite3
*.db-journal

# 探查用外部 skill 工具（勿入库）
.uiux-skill-probe/

# 结构化日志（SR-NF13：logs/timeflow.jsonl 是本机运行产物，不入库）
logs/

# 重构对照快照（按需从 git 历史导出，用于人工并排 diff；不属于源码）
snapshots/

# 沉淀型 markdown 的默认落盘目录（SR-F8 / T-G4：**产物**，不是源码；用户可改到别处）
export/

# 界面比对用的临时截图（tools/ui_ab.py + 无头浏览器产出）
.debug-ui/

# 工具缓存
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# 受限沙箱下 pytest basetemp 遗留目录（建出后不可删/不可读，非项目产物）
.p_*/
.pt*/

# 沙箱探针残留目录（同 basetemp，不可删）
md_700/
m_acl2/
m_acl81z2m_qc/
m_mkdtempvfsar68a/
seqa_29mzr1/
tfprobe5tbeq3at/
um1/
um2/

# 说明：gates/last.json **要入库**（它是门禁落盘产物，审计脚本按它核对提交里 Gates: trailer 的真伪）
# 只有临时产物不入库：
gates/last.json.tmp
.pytest_tmp/

# 每道门的**全量输出**（T-G58）：失败时不用把门单独再跑一遍才能看原因（render 110s / ui_flow 176s）。
# 它是本机诊断产物，不入库 —— 入库的只有 last.json（结论）与渲染黄金（判据）。
gates/logs/
gates/diag/

# 例外（T-G159）：门禁串行锁是**每棵树都会调用**的工具，改它必须能进提交
# （卡 062 踩过：改好却进不了提交，只能手工拷）。**只放这一个文件** ——
# 卡规格、诊断日志、活文档（自动推进表/队列）仍不入库。
!gates/diag/
gates/diag/*
!gates/diag/gate_lock.py

# 渲染验证层的**截图**（T-G32）：`gates/render/*.txt` 是黄金（入库），
# `shots/*.png` 是给人看的证据（按需 `node tools/render_check.mjs --shots` 重出，2.5 MB，不入库）
gates/render/shots/

# 视觉线的**候选预演**（T-G49 起）：候选 CSS 是"覆盖层"，选定后并进 `app.css` 才算数，
# 截图与数字表同理（`tools/candidate_shots.mjs` 按需重出）。入库会让"样式只有一份真源"
# 变成两份，而且候选在选定那一刻就过期了 —— 决策本身记在 `复盘/` 与 app.css 的注释里。
gates/candidates/
gates/render/candidates/

# 前端构建产物（如需）
src/web/dist/
node_modules/

# 编辑器
.vscode/
.idea/
*.swp

# 号池 CLI（infra/pool 派活）在自己跑过的树里留下的状态目录 —— 不是项目产物
.codeartsdoer/
